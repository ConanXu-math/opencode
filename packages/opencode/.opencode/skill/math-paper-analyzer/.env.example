# Math Paper Analyzer - Environment Configuration

# OCR Configuration (Required)
# Default OCR service for math formulas
MATH_PAPER_OCR_URL=https://edusys5.sii.edu.cn/ocr

# LLM Configuration (Optional - for standard/deep analysis modes)
# Option 1: OpenAI
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# Option 2: Custom OpenAI-compatible API
# MATH_PAPER_LLM_API_KEY=your_api_key_here
# MATH_PAPER_LLM_BASE_URL=https://your-api.com/v1
# MATH_PAPER_LLM_MODEL=your-model-id

# Processing Configuration (Optional)
# MATH_PAPER_TEMP_DIR=/tmp/math-paper-analyzer
# MATH_PAPER_MAX_WORKERS=4
# MATH_PAPER_OCR_TIMEOUT=60.0
# MATH_PAPER_OCR_DPI=200