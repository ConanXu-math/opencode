# Math Paper Analyzer - Environment Configuration

# OCR Configuration (Required)
# Default OCR service for math formulas
MATH_PAPER_OCR_URL=https://edusys5.sii.edu.cn/ocr

# Note: LLM analysis is handled by opencode, not configured here
# No LLM API keys needed in this file

# Processing Configuration (Optional)
# MATH_PAPER_TEMP_DIR=/tmp/math-paper-analyzer
# MATH_PAPER_MAX_WORKERS=4
# MATH_PAPER_OCR_TIMEOUT=60.0
# MATH_PAPER_OCR_DPI=200